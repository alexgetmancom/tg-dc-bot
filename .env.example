# Runtime
NODE_ENV=development
APP_NAME=Discord & Telegram Voice Bot
TZ=Europe/Moscow

# polling | webhook | http-only
BOT_MODE=polling
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_TOKEN=
STEAM_API_KEY=

# Comma-separated Telegram IDs. Required when bots are enabled.
ALLOWED_USERS=
# Comma-separated Telegram IDs allowed to use /status.
ADMIN_USER_IDS=

# Required in webhook mode only
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_WEBHOOK_URL=

# Storage
DATABASE_URL=./data/voice_stats.db

# HTTP
BIND_HOST=127.0.0.1
PORT=8080

# Background worker
WORKER_INTERVAL_SECONDS=60
